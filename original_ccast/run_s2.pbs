#!/bin/bash
#PBS -N ico_s2
#PBS -q gpus
#PBS -l select=1:mem=64gb:ncpus=16:ngpus=1
#PBS -l walltime=14:00:00
#PBS -W group_list=x-ccast-prj-hpirim
#PBS -j oe
#PBS -m abe
#PBS -M faria.farzana@ndsu.edu

# ──────────────────────────────────────────────────────────────
# Scenario S2 — Demand volatility (retrains all three models)
# Adds Gaussian load noise, then runs three_model_comparison.py.
# ──────────────────────────────────────────────────────────────
# Usage: for s in 42 123 456 789 1024; do qsub -v SEED=$s run_s2.pbs; done
# ──────────────────────────────────────────────────────────────

# ── PATHS ────────────────────────────────────────────────────
WORK_DIR="$PBS_O_WORKDIR"
SCRIPT="$WORK_DIR/scenario_s2.py"
VENV="$WORK_DIR/e2e"
LOG_DIR="$WORK_DIR/run_logs"

# ── SETUP ────────────────────────────────────────────────────
mkdir -p "$LOG_DIR"
cd "$WORK_DIR" || { echo "Cannot cd to $WORK_DIR"; exit 1; }

echo "=============================================="
echo " Job ID        : $PBS_JOBID"
echo " Node list     : $(cat $PBS_NODEFILE)"
echo " Work dir      : $WORK_DIR"
echo " Submit time   : $(date)"
echo " SCENARIO      : S2 (demand volatility)"
echo " SEED          : ${SEED}"
echo " Python script : $SCRIPT"
echo "=============================================="

# ── Load modules ─────────────────────────────────────────────
module purge
module load python/3.12.2
module load cuda11.8/toolkit/11.8.0

# ── Activate virtual environment ─────────────────────────────
source "$VENV/bin/activate"

# ── Verify ───────────────────────────────────────────────────
echo ""
echo "Environment check:"
echo "  Python : $(which python)"
echo "  Version: $(python --version 2>&1)"
echo "  Venv   : $VIRTUAL_ENV"
echo ""
python -c "import torch; print(f'  PyTorch: {torch.__version__}, CUDA: {torch.cuda.is_available()}')" 2>&1
python -c "import cvxpylayers; print('  cvxpylayers: OK')" 2>&1 || { echo "ERROR: cvxpylayers missing"; exit 1; }
python -c "import cvxpy; print('  cvxpy: OK')" 2>&1 || { echo "ERROR: cvxpy missing"; exit 1; }
python -c "import ecos; print('  ECOS solver: OK')" 2>&1 || { echo "ERROR: ecos missing"; exit 1; }
python -c "import sklearn; print('  sklearn: OK')" 2>&1 || { echo "ERROR: sklearn missing"; exit 1; }
python -c "import pandas; print('  pandas: OK')" 2>&1 || { echo "ERROR: pandas missing"; exit 1; }
echo ""
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader 2>/dev/null || echo "  nvidia-smi not available"
echo ""

# ── THREAD / GPU SETTINGS ────────────────────────────────────
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
export NUMEXPR_NUM_THREADS=8
export CUDA_VISIBLE_DEVICES=0
export MPLBACKEND=Agg

# ── Scenario / seed / data settings ──────────────────────────
export SEED=${SEED:-42}
export BASE_DATA="$WORK_DIR"        # original data/ lives here
export NOISE_SIGMA=2000
export NOISE_SEED=20240101          # fixed: every model seed sees the same noisy data
export REUSE_ICO=0                  # IMPORTANT: data changed -> ICO must retrain (do NOT reuse base forecasts)

# ── Verify ORIGINAL data is present before launching ─────────
if [ ! -f "$BASE_DATA/data/modified_dataset.csv" ]; then
    echo "ERROR: energy data not found at $BASE_DATA/data/modified_dataset.csv"; exit 1
fi
if [ ! -f "$BASE_DATA/data/weather_features.csv" ]; then
    echo "ERROR: weather data not found at $BASE_DATA/data/weather_features.csv"; exit 1
fi

# ── RUN ──────────────────────────────────────────────────────
echo "Starting S2 (SEED=${SEED}) at $(date)"; echo ""
python "$SCRIPT" 2>&1 | tee "$LOG_DIR/ico_s2_seed${SEED}_${PBS_JOBID}.log"
EXIT_CODE=${PIPESTATUS[0]}

echo ""
echo "=============================================="
echo " S2 SEED ${SEED} finished at $(date)"
echo " Exit code: $EXIT_CODE"
echo " Results:   $WORK_DIR/results/s2/seed${SEED}/comparison_seed${SEED}.csv"
echo "=============================================="
exit $EXIT_CODE
